{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-course/skill-trace.schema.json",
  "title": "Repository-local skill execution trace manifest",
  "$defs": {
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "summary": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "\\S" },
    "slug": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9._/-]+$" },
    "ref": {
      "type": "string",
      "minLength": 1,
      "anyOf": [
        { "pattern": "^https?://[^/?#\\s]+[^?#\\s]*$" },
        { "pattern": "^(?!/|\\\\|[A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\r\\n]+$" }
      ]
    }
  },
  "type": "object",
  "required": [
    "schema_version",
    "execution_id",
    "execution_kind",
    "skill",
    "repository",
    "started_at",
    "request_summary",
    "input_refs",
    "retention_days",
    "privacy"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0" },
    "execution_id": { "type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z-[a-z0-9-]+-[0-9a-f]{8}$" },
    "execution_kind": { "const": "skill" },
    "skill": {
      "type": "object",
      "required": ["name", "path", "sha256"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "path": { "type": "string", "pattern": "^\\.agents/skills/[a-z0-9]+(?:-[a-z0-9]+)*/SKILL\\.md$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "repository": {
      "type": "object",
      "required": ["head", "dirty"],
      "additionalProperties": false,
      "properties": {
        "head": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
        "dirty": { "type": ["boolean", "null"] }
      }
    },
    "started_at": { "$ref": "#/$defs/timestamp" },
    "request_summary": { "$ref": "#/$defs/summary" },
    "input_refs": { "type": "array", "items": { "$ref": "#/$defs/ref" } },
    "parent_workflow_run": { "anyOf": [{ "$ref": "#/$defs/slug" }, { "type": "null" }] },
    "agent_id": { "anyOf": [{ "$ref": "#/$defs/slug" }, { "type": "null" }] },
    "retention_days": { "type": "integer", "minimum": 1 },
    "privacy": {
      "type": "object",
      "required": ["raw_prompt", "chain_of_thought", "secrets", "personal_data"],
      "additionalProperties": false,
      "properties": {
        "raw_prompt": { "const": false },
        "chain_of_thought": { "const": false },
        "secrets": { "const": false },
        "personal_data": { "const": false }
      }
    }
  }
}
