{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-course/skill-event.schema.json",
  "title": "Repository-local skill execution event",
  "oneOf": [
    {
      "type": "object",
      "required": ["seq", "event", "at", "summary", "refs"],
      "additionalProperties": false,
      "properties": {
        "seq": { "type": "integer", "minimum": 1 },
        "event": { "enum": ["started", "artifact", "check", "correction", "retry", "limitation", "note"] },
        "at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
        "summary": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "\\S" },
        "refs": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    {
      "type": "object",
      "required": ["seq", "event", "at", "outcome", "summary", "refs"],
      "additionalProperties": false,
      "properties": {
        "seq": { "type": "integer", "minimum": 1 },
        "event": { "const": "finished" },
        "at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
        "outcome": { "enum": ["completed", "failed", "cancelled", "not-verified"] },
        "summary": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "\\S" },
        "refs": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    }
  ]
}
